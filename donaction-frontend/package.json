{
  "name": "donaction-frontend",
  "version": "1.0.0",
  "description": "Donaction web app - Frontend Next.js",
  "author": "Nakaa",
  "license": "UNLICENSED",
  "packageManager": "yarn@1.22.19",
  "scripts": {
    "dev:re7": "cp .env.re7 .env && next dev ",
    "dev": "NODE_OPTIONS='--inspect' next dev",
    "dev:local": "next dev",
    "dev:stripe": "sh ./scripts/stripe-dev.sh",
    "dev:saas": "LOOP=true sh ./scripts/saas-dev.sh",
    "build:saas": "LOOP=false sh ./scripts/saas-dev.sh",
    "build:saas:local": "cd /repos/klubr/donaction/donaction-frontend && npm run build:saas",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "format": "prettier -w ./src",
    "copytypes": "node scripts/copyTypesFromStrapi.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.5.1",
    "@fortawesome/free-solid-svg-icons": "^6.5.1",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@next/bundle-analyzer": "^14.2.13",
    "@next/third-parties": "^15.1.2",
    "@reduxjs/toolkit": "^2.2.5",
    "@stripe/react-stripe-js": "^2.4.0",
    "@stripe/stripe-js": "^2.2.2",
    "@types/grecaptcha": "^3.0.9",
    "date-fns": "^2.30.0",
    "jose": "^5.9.6",
    "lottie-web": "^5.12.2",
    "next": "^14.2.15",
    "next-auth": "^4.24.8",
    "primereact": "^10.6.6",
    "react": "^18.3.1",
    "react-countup": "^6.4.2",
    "react-dom": "^18.3.1",
    "react-icons": "^4.10.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.23.1",
    "react-share": "^5.0.3",
    "react-tooltip": "^5.25.2",
    "react-visibility-sensor": "^5.1.1",
    "schema-dts": "^1.1.2",
    "sharp": "^0.33.5",
    "stripe": "^14.10.0",
    "swiper": "^11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/google.maps": "^3.55.9",
    "@types/node": "20.4.0",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.3",
    "jsdom": "^28.0.0",
    "postcss": "^8.4.38",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "sass": "^1.63.6",
    "tailwindcss": "^3.3.2",
    "typescript": "5.1.6",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
