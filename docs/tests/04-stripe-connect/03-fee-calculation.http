### 3.1 Scenario A - Donor pays fees on top (PR #175, #177)
# @name paymentIntentScenarioA
# Assert: returns intent, total > 5000 cents, platform commission = 4% net
# Requires: DON_SC_UUID from 02-donor-pays-fee.http
POST {{BASE_URL}}/klub-don-payments/create-payment-intent
Authorization: Bearer {{JWT}}
Content-Type: application/json

{
  "price": 50,
  "metadata": {
    "donUuid": "{{DON_SC_UUID}}",
    "klubUuid": "{{KLUBR_SC_UUID}}"
  },
  "donorPaysFee": true
}

> {%
  client.test("Status 200", function () {
    client.assert(response.status === 200);
  });
  client.test("Returns client_secret", function () {
    client.assert(response.body.intent, "No intent/client_secret returned");
  });
  client.global.set("CLIENT_SECRET_A", response.body.intent);
  client.log("Intent: " + response.body.intent);
%}

###

### 3.2 Scenario B - Fees deducted from donation (PR #175, #177)
# @name paymentIntentScenarioB
# Assert: returns intent, donor charged exactly 50 EUR, association receives less
POST {{BASE_URL}}/klub-don-payments/create-payment-intent
Authorization: Bearer {{JWT}}
Content-Type: application/json

{
  "price": 50,
  "metadata": {
    "donUuid": "{{DON_SC_UUID}}",
    "klubUuid": "{{KLUBR_SC_UUID}}"
  },
  "donorPaysFee": false
}

> {%
  client.test("Status 200", function () {
    client.assert(response.status === 200);
  });
  client.test("Returns client_secret", function () {
    client.assert(response.body.intent, "No intent/client_secret returned");
  });
%}

