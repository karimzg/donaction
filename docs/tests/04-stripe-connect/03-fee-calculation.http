### 3.4 Backward compat - default fallback 1.5% + 0.25 EUR (PR #175)
# Use a klubr with stripe_fee_percentage=null and stripe_fee_fixed=null
# Assert: falls back to 1.5% + 0.25 EUR defaults
# This is the same as 3.1/3.2 if the trade_policy has null fee fields
POST {{BASE_URL}}/klub-don-payments/create-payment-intent
Authorization: Bearer {{JWT}}
Content-Type: application/json

{
  "price": 100,
  "metadata": {
    "donUuid": "{{DON_SC_UUID}}",
    "klubUuid": "{{KLUBR_SC_UUID}}"
  },
  "donorPaysFee": true
}

> {%
  client.test("Status 200", function () {
    client.assert(response.status === 200);
  });
  client.test("Returns client_secret", function () {
    client.assert(response.body.intent);
  });
%}

###

### 3.5 Account not activated - blocked (Issue #60, Scenario 4)
# @name paymentIntentAccountDisabled
# Assert: 400 error when charges_enabled = false
# Requires: A klubr with stripe_connect=true but charges_enabled=false
POST {{BASE_URL}}/klub-don-payments/create-payment-intent
Authorization: Bearer {{JWT}}
Content-Type: application/json

{
  "price": 50,
  "metadata": {
    "donUuid": "{{DON_SC_UUID}}",
    "klubUuid": "{{KLUBR_SC_DISABLED_UUID}}"
  },
  "donorPaysFee": true
}

> {%
  client.test("Status 400", function () {
    client.assert(response.status === 400);
  });
  client.test("Error message mentions activation", function () {
    const msg = response.body.error?.message || "";
    client.assert(msg.includes("pas encore activé"), "Expected account not activated error");
  });
%}
